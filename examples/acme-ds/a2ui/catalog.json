{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example/a2ui/v0.9/catalog.json",
  "title": "acme-ds A2UI Catalog",
  "description": "Design-system catalog generated from acme-ds. Agents must only emit components listed here.",
  "catalogId": "https://acme.example/a2ui/v0.9/catalog.json",
  "components": {
    "Row": {
      "type": "object",
      "description": "Arranges children horizontally.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Row"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Child component ids or a template over a data list."
            },
            "justify": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "spaceBetween",
                "spaceAround",
                "spaceEvenly",
                "stretch"
              ],
              "default": "start"
            },
            "align": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ],
              "default": "stretch"
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Column": {
      "type": "object",
      "description": "Arranges children vertically.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Column"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Child component ids or a template over a data list."
            },
            "justify": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "spaceBetween",
                "spaceAround",
                "spaceEvenly",
                "stretch"
              ],
              "default": "start"
            },
            "align": {
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ],
              "default": "stretch"
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Alert": {
      "type": "object",
      "description": "Alert from the source design system.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Alert"
            },
            "message": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'message'."
            },
            "tone": {
              "type": "string",
              "enum": [
                "info",
                "success",
                "warning",
                "danger"
              ],
              "description": "Mapped from design-system prop 'tone'."
            }
          },
          "required": [
            "component",
            "message"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "description": "Primary call-to-action and secondary buttons.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "label": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'label'."
            },
            "variant": {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "ghost"
              ],
              "description": "Mapped from design-system prop 'variant'."
            },
            "disabled": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Mapped from design-system prop 'disabled'."
            },
            "action": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
              "description": "Mapped from design-system prop 'onPress'."
            }
          },
          "required": [
            "component",
            "label"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "description": "Card from the source design system.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Card"
            },
            "title": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'title'."
            },
            "subtitle": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'subtitle'."
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Mapped from design-system prop 'children'. Children must be referenced by id."
            }
          },
          "required": [
            "component",
            "title",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "TextField": {
      "type": "object",
      "description": "TextField from the source design system.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "TextField"
            },
            "label": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'label'."
            },
            "value": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'value'."
            },
            "placeholder": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Mapped from design-system prop 'placeholder'."
            },
            "required": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
              "description": "Mapped from design-system prop 'required'."
            },
            "action": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
              "description": "Mapped from design-system prop 'onChange'."
            }
          },
          "required": [
            "component",
            "label"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "Validates that a value is present.",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": [
        "call",
        "args"
      ],
      "unevaluatedProperties": false
    },
    "formatString": {
      "type": "object",
      "description": "Formats a string template.",
      "properties": {
        "call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "template": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
            }
          },
          "required": [
            "template"
          ]
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": [
        "call",
        "args"
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Relative flex weight when this component is a direct child of Row or Column."
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Primary brand color as a 6-digit hex value."
        },
        "colorPrimary": {
          "type": "string",
          "description": "Token color.primary from the design system.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#1d4ed8"
        },
        "colorOnPrimary": {
          "type": "string",
          "description": "Token color.on.primary from the design system.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#ffffff"
        },
        "fontFamilySans": {
          "type": "string",
          "description": "Token font.family.sans from the design system.",
          "default": "\"Inter\", sans-serif"
        },
        "colorDanger": {
          "type": "string",
          "description": "Token color.danger from the design system.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#DC2626"
        },
        "colorSurface": {
          "type": "string",
          "description": "Token color.surface from the design system.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#F8FAFC"
        },
        "colorText": {
          "type": "string",
          "description": "Token color.text from the design system.",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#0F172A"
        },
        "spaceSm": {
          "type": "string",
          "description": "Token space.sm from the design system.",
          "default": "8px"
        },
        "spaceMd": {
          "type": "string",
          "description": "Token space.md from the design system.",
          "default": "16px"
        },
        "spaceLg": {
          "type": "string",
          "description": "Token space.lg from the design system.",
          "default": "24px"
        },
        "radiusMd": {
          "type": "string",
          "description": "Token radius.md from the design system.",
          "default": "8px"
        }
      },
      "additionalProperties": true
    },
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Row"
        },
        {
          "$ref": "#/components/Column"
        },
        {
          "$ref": "#/components/Alert"
        },
        {
          "$ref": "#/components/Button"
        },
        {
          "$ref": "#/components/Card"
        },
        {
          "$ref": "#/components/TextField"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "oneOf": [
        {
          "$ref": "#/functions/required"
        },
        {
          "$ref": "#/functions/formatString"
        }
      ]
    }
  }
}
