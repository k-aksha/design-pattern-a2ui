{
  "name": "design-pattern-a2ui",
  "version": "0.1.0",
  "description": "Agent that converts an existing design system into an A2UI v0.9 catalog.",
  "type": "module",
  "bin": {
    "ds2a2ui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "convert": "tsx src/cli.ts convert",
    "test": "tsx --test src/agent.test.ts",
    "example": "tsx src/cli.ts convert examples/acme-ds --out examples/acme-ds/a2ui"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5"
  }
}
